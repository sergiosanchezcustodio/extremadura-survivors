node_modules/
.DS_Store

# Secretos locales (tokens de API para generar/traer assets, etc.). Nunca al
# repositorio: cada quien pone el suyo en su copia.
.env

# Salidas de compilación y descargas del lanzador. Son cientos de megas de
# ejecutables y de runtime de NW.js que se regeneran con las herramientas:
# no tienen por qué vivir en el repositorio.
dist/
herramientas/lanzador/cache/

# Imágenes de prueba generadas con Replicate (ver herramientas/generar-imagen.js).
# Es un cajón de bocetos: se tiran casi todos. Lo que valga se mueve a mano a
# resources/<lo que sea>/ y ahí sí se versiona.
resources/generadas/

# Versiones anteriores del arte que Sergio aparta al redibujar. Son descartes,
# no respaldo: una vez dentro del historial de git esos megas ya no se quitan y
# se los traga todo el que clone.
resources/**/OLD/

# Rastros de las sesiones de Playwright: capturas y volcados de consola.
.playwright-mcp/
